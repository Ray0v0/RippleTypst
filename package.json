{
  "name": "mytypst",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight local Typst editor with live PDF preview",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "esbuild public/app.js --bundle --outfile=public/dist/app.js --format=esm --minify && cp node_modules/pdfjs-dist/build/pdf.worker.mjs public/dist/pdf.worker.mjs",
    "test": "node --test test/project.test.js test/http.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.0",
    "@lezer/highlight": "^1.2.0",
    "codemirror": "^6.0.1",
    "express": "^4.21.0",
    "pdfjs-dist": "^4.6.82"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
